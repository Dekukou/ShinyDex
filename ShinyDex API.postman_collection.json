					""
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"packages": {},
				"requests": {},
				"exec": [
					"// ============================================================\r",
					"// AUTOMATIC JWT TOKEN REFRESH MECHANISM\r",
					"// ============================================================\r",
					"// Ce script s'exécute après CHAQUE requête de la collection.\r",
					"// Il détecte les erreurs 401 \"Expired JWT Token\" et:\r",
					"// 1. Appelle automatiquement la requête Login pour obtenir un nouveau token\r",
					"// 2. Stocke le nouveau token dans la variable de collection {{token}}\r",
					"// 3. Relance UNE SEULE FOIS la requête initiale qui avait échoué\r",
					"// ============================================================\r",
					"\r",
					"(async function() {\r",
					"    // --- CONFIGURATION ---\r",
					"    const LOGIN_URL = pm.collectionVariables.get('baseURL') + '/login_check';\r",
					"    const LOGIN_CREDENTIALS = {\r",
					"        username: 'admin',\r",
					"        password: 'admin'\r",
					"    };\r",
					"    \r",
					"    // --- FLAG ANTI-BOUCLE INFINIE ---\r",
					"    const RETRY_FLAG = '__token_refresh_attempted__';\r",
					"    const hasAlreadyRetried = pm.variables.get(RETRY_FLAG);\r",
					"    \r",
					"    // --- DÉTECTION DU 401 AVEC \"Expired JWT Token\" ---\r",
					"    if (pm.response.code === 401 && !hasAlreadyRetried) {\r",
					"        let responseBody;\r",
					"        try {\r",
					"            responseBody = pm.response.json();\r",
					"        } catch (e) {\r",
					"            responseBody = pm.response.text();\r",
					"        }\r",
					"        \r",
					"        // Vérifie si le message contient \"Expired JWT Token\"\r",
					"        const isExpiredToken = \r",
					"            (typeof responseBody === 'object' && responseBody.message && responseBody.message.includes('Expired JWT Token')) ||\r",
					"            (typeof responseBody === 'string' && responseBody.includes('Expired JWT Token'));\r",
					"        \r",
					"        if (isExpiredToken) {\r",
					"            console.log('🔄 Token JWT expiré détecté - Tentative de rafraîchissement automatique...');\r",
					"            \r",
					"            // --- ÉTAPE 1: Appeler Login pour obtenir un nouveau token ---\r",
					"            try {\r",
					"                const loginResponse = await pm.sendRequest({\r",
					"                    url: LOGIN_URL,\r",
					"                    method: 'POST',\r",
					"                    header: { 'Content-Type': 'application/json' },\r",
					"                    body: {\r",
					"                        mode: 'raw',\r",
					"                        raw: JSON.stringify(LOGIN_CREDENTIALS)\r",
					"                    }\r",
					"                });\r",
					"                \r",
					"                // --- ÉTAPE 2: Extraire et stocker le nouveau token ---\r",
					"                if (loginResponse.code === 200) {\r",
					"                    const loginData = loginResponse.json();\r",
					"                    \r",
					"                    if (loginData && loginData.token) {\r",
					"                        pm.collectionVariables.set('token', loginData.token);\r",
					"                        console.log('✅ Nouveau token JWT obtenu et stocké dans {{token}}');\r",
					"                        \r",
					"                        // --- ÉTAPE 3: Marquer le flag et relancer la requête ---\r",
					"                        pm.variables.set(RETRY_FLAG, true);\r",
					"                        pm.execution.setNextRequest(pm.info.requestName);\r",
					"                        console.log('🔁 Relance de \"' + pm.info.requestName + '\" avec le nouveau token...');\r",
					"                    } else {\r",
					"                        console.error('❌ Token non trouvé dans la réponse de login');\r",
					"                    }\r",
					"                } else {\r",
					"                    console.error('❌ Erreur login: Status ' + loginResponse.code);\r",
					"                }\r",
					"            } catch (error) {\r",
					"                console.error('❌ Erreur rafraîchissement token:', error);\r",
					"            }\r",
					"        }\r",
					"    } else if (pm.response.code === 401 && hasAlreadyRetried) {\r",
					"        console.error('⚠️ Retry déjà effectué - Pas de nouvelle tentative (anti-boucle infinie)');\r",
					"    }\r",
					"})();"
				]
			}
		}
	],
